{
  "name": "seethis-runs",
  "version": "0.4.1",
  "description": "Codex-only SeeThis reference run history demo. Stores IDs and log pointers, never prompt or log copies.",
  "skills": "./skills/",
  "mcpServers": "./.mcp.json",
  "hooks": {
    "hooks": {
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "{ [ -n \"${PLUGIN_ROOT:-}\" ] && python3 \"${PLUGIN_ROOT}/seethis_runs/hooks.py\"; } >/dev/null 2>&1 || :",
              "timeout": 1
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "{ [ -n \"${PLUGIN_ROOT:-}\" ] && python3 \"${PLUGIN_ROOT}/seethis_runs/hooks.py\"; } >/dev/null 2>&1 || :",
              "timeout": 1
            }
          ]
        }
      ],
      "Interrupt": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "{ [ -n \"${PLUGIN_ROOT:-}\" ] && python3 \"${PLUGIN_ROOT}/seethis_runs/hooks.py\"; } >/dev/null 2>&1 || :",
              "timeout": 1
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "{ [ -n \"${PLUGIN_ROOT:-}\" ] && python3 \"${PLUGIN_ROOT}/seethis_runs/hooks.py\"; } >/dev/null 2>&1 || :",
              "timeout": 1
            }
          ]
        }
      ]
    }
  }
}
